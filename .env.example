# Bu dosyayı .env olarak kopyalayın: cp .env.example .env  (veya: make env)
# .env gitignore'da; sır içeren gerçek değerler repoya girmez.

# --- Uygulama ---
APP_ENV=development
LOG_LEVEL=info
HTTP_PORT=8080
SHUTDOWN_TIMEOUT=15s

# --- İstek sınırları ---
# Gövde boyutu bayt cinsinden. Tekil uçta içerik en fazla 10.000 karakter olduğu için
# ~40 KB yeterli; batch'te 1000 × 10.000 karakter e-posta en kötü durumda ~10 MB tutar.
# 1000 kayıt sınırı ile bu bayt sınırı BİRLİKTE uygulanır: çok uzun içerikli batch'ler
# kayıt sayısına ulaşmadan bayt sınırına takılabilir.
BODY_LIMIT_SINGLE=131072
BODY_LIMIT_BATCH=16777216

# Saklanan idempotency cevaplarının geçerlilik süresi. Süresi dolan anahtar yeniden
# kullanılabilir hâle gelir; temizlik işi ayrıca worker'da koşar (Adım 6).
IDEMPOTENCY_TTL=24h

# --- PostgreSQL ---
# Compose içindeki api servisi host adını "postgres" olarak ezer (docker-compose.yml).
# Aşağıdaki değer, uygulamayı host'tan çalıştırdığınızda kullanılır.
POSTGRES_USER=insider
POSTGRES_PASSWORD=insider
POSTGRES_DB=notifications
POSTGRES_PORT=5432
DATABASE_URL=postgres://insider:insider@localhost:5432/notifications?sslmode=disable

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Worker (cmd/worker) ---
# WORKER_CONCURRENCY ayni zamanda bir worker'in tutabilecegi EN FAZLA lease sayisi:
# claimer yalnizca bostaki sender kadar is ceker. Bu yuzden claim parti boyutu lease
# hesabina girmez ve bir satirin claim'den sonuca kadar gecirdigi sure tek dalgadir
# (saglayici cagrisi + sonuc yazimi).
WORKER_CONCURRENCY=20
WORKER_CLAIM_BATCH_SIZE=20

# Lease, en kotu gonderim penceresinin (PROVIDER + RESULT = 13s) iki katini kapsamali;
# kapsamazsa lease is bitmeden dolar, reaper satiri devralir ve mesaj iki kez gider.
# worker.New bu esitsizligi acilista dogruluyor.
WORKER_LEASE_DURATION=60s
WORKER_PROVIDER_TIMEOUT=10s
WORKER_RESULT_TIMEOUT=3s

# Kapanista ucan gonderimlerin bitmesi icin beklenen sure. Gonderim penceresinden
# kisa olamaz: erken donmek, basarili gonderimlerin sonucunu yazamamak demek.
WORKER_DRAIN_TIMEOUT=20s

# Bos kuyrukta bekleme araligi (full jitter uygulanir, kopyalar ayni anda sorgu atmasin).
WORKER_POLL_MIN_INTERVAL=50ms
WORKER_POLL_MAX_INTERVAL=2s

# Adim 6'nin gecici retry gecikmesi. Adim 8'de siniflandirma + exponential backoff
# (min(2s*2^(n-1), 5dk) + jitter) bunun yerini alacak.
WORKER_RETRY_DELAY=5s

# Lease kurtarma donguesu: lease suresinin ~1/6'si, tek supurme LIMIT'li.
WORKER_REAPER_INTERVAL=10s
WORKER_REAPER_BATCH_SIZE=100

# pgx varsayilani max(4, NumCPU): 3 kanal x 20 sender ile sonuc yazmalari sessizce
# siraya girerdi. 3 kopya x 16 + api, Postgres'in 100 baglanti sinirinin altinda kalir.
WORKER_DB_MAX_CONNS=16

# Suresi dolmus idempotency anahtarlarinin temizligi (API degil worker kosturur).
# Dogruluk buna bagli DEGIL (Adim 4): suresi dolmus anahtar lookup'ta zaten yok
# sayiliyor. Temizlik yalnizca tabloyu kucuk tutmak icin.
IDEMPOTENCY_CLEANUP_INTERVAL=1h
IDEMPOTENCY_CLEANUP_BATCH=1000

# Worker'in baktigi saglayici. Compose bu degeri PROVIDER_URL olarak worker'a geciriyor;
# varsayilan mock, boylece yuk testleri webhook.site kotasini yakmaz.
WORKER_PROVIDER_URL=http://mockprovider:8081/send

# --- Mock provider (cmd/mockprovider) ---
# Oranlar 0-1 arasi olasilik; sirayla denenir (bad request, rate limit, failure).
# 0.3 yerine 30 yazmak "her istek basarisiz" demek olurdu, bu yuzden aralik dogrulaniyor.
# Davranis calisma aninda degistirilebilir (container restart'i gerekmez):
#   curl -X POST localhost:8081/config -d '{"failure_rate":0.3,"latency":"50ms"}'
#   curl localhost:8081/stats     -> durum kodu ve kanal bazinda sayaclar
MOCK_PORT=8081
MOCK_FAILURE_RATE=0
MOCK_RATE_LIMIT_RATE=0
MOCK_BAD_REQUEST_RATE=0
MOCK_LATENCY=50ms
MOCK_LATENCY_JITTER=0s

# --- Bildirim sağlayıcısı ---
# Gerçek dış entegrasyon demosu. Ücretsiz webhook.site URL'i 100 istek / 7 gün ile
# sınırlıdır; yük testlerinde Adım 6'da gelen mock-provider kullanılır.
PROVIDER_URL=https://webhook.site/763a3eae-f247-45ae-be9a-60bea4fd2fb0
